<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.3.1</Version>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <PackageId>InertiaCore.AspNetCore</PackageId>
        <Authors>Creator-Solutions</Authors>
        <Description>Inertia.js ASP.NET Adapter. https://inertiajs.com/</Description>
        <PackageProjectUrl>https://github.com/Creator-Solutions/InertiaCore</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Creator-Solutions/InertiaCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>Inertia,Inertiajs,ASPNET,Vue, React</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- Ship XML documentation with the package. CS1591 (missing XML comment for
             publicly visible type or member) is suppressed so the new documentation
             requirement does not introduce warnings for pre-existing public API. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.IO.Abstractions" Version="19.2.16" />
    </ItemGroup>

    <!-- SSR resilience (IN-69): typed HttpClient + standard resilience handler
         (timeout, retry with jitter, circuit breaker). Version-matched per TFM;
         the API surface used (HttpStandardResilienceOptions, AddStandardResilienceHandler)
         is identical across these versions. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.7.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="" />
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InertiaCore.SourceGenerators\InertiaCore.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!--
        Packs the source generator into this package under analyzers/dotnet/cs.
        The generator output path is resolved via the MSBuild GetTargetPath target so
        it stays correct if the generator's target framework changes. Only included
        for a single TFM to avoid duplicate entries in the multi-targeted package.
    -->
    <Target Name="IncludeGeneratorInPackage"
            BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="..\InertiaCore.SourceGenerators\InertiaCore.SourceGenerators.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_GeneratorDll" />
        </MSBuild>
        <ItemGroup>
            <None Include="@(_GeneratorDll)"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs"
                  Visible="false" />
        </ItemGroup>
    </Target>
</Project>
