<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.3.1</Version>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <PackageId>InertiaCore.Aspire.Hosting</PackageId>
        <Authors>Creator-Solutions</Authors>
        <Description>.NET Aspire hosting integration for InertiaCore: adds the Vite dev server and Node SSR process as Aspire resources with service discovery, health checks and dashboard logs.</Description>
        <PackageProjectUrl>https://github.com/Creator-Solutions/InertiaCore</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Creator-Solutions/InertiaCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageTags>Inertia,Inertiajs,ASPNET,Aspire,Hosting,Vite,SSR</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!--
            Aspire.Hosting.JavaScript pulls in MessagePack 2.5.302, which carries the
            GHSA-qhrr-8q5h-9q3h advisory. The dependency is transitive and pinned by
            Aspire; suppress the audit warning rather than overriding Aspire's graph.
        -->
        <NoWarn>$(NoWarn);NU1902</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InertiaCore\InertiaCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="InertiaCoreTests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="" />
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
